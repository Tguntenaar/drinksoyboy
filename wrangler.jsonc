{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Static-assets Worker: no script, Cloudflare serves ./dist directly.
  "name": "drinksoyboy",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  // Custom domains on the Cloudflare zone.
  "routes": [
    { "pattern": "drinksoyboy.com", "custom_domain": true },
    { "pattern": "www.drinksoyboy.com", "custom_domain": true }
  ],
  "workers_dev": false
}
